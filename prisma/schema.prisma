generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BibliographyEntryType {
  BASIC
  COMPLEMENTARY
  REA
}

enum ProjectWorkflowMode {
  NEW
  ADAPTATION_16_TO_8
}

enum LegacyDocumentType {
  PLAN_16_WEEKS
  GUIDE_16_WEEKS
}

enum AdaptationTarget {
  PLAN
  GUIDE
}

enum AdaptationProposalStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  SUPERSEDED
}

enum AdaptationAction {
  KEEP
  GROUP
  MERGE
  SYNTHESIZE
  MOVE
  REFORMULATE
  DELETE
  SPLIT
  UPDATE
}

enum AdaptationDecision {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
  REGENERATE
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum WeekStatus {
  PENDING
  GENERATED
  IN_REVIEW
  APPROVED
  REQUIRES_REVIEW
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AttachmentKind {
  MATRIX
  BIBLIOGRAPHY
  WEEK_ADJUSTMENT
  GENERATED_IMAGE
  KNOWLEDGE
}

enum ReviewStage {
  PEER
  QUALITY
  DIITEP
}

enum ChecklistResult {
  PENDING
  COMPLIES
  COMPLIES_PARTIALLY
  DOES_NOT_COMPLY
  NOT_APPLICABLE
}

enum TeachingActivityComponent {
  ACD
  APE
  AA
}

enum TeachingPlanInstrumentType {
  QUESTIONNAIRE
  RUBRIC
  CHECKLIST
  RATING_SCALE
  OTHER
}

enum QuestionnaireGradingMode {
  LAST_ATTEMPT
  HIGHEST_GRADE
}

enum ReviewDecision {
  DRAFT
  APPROVED
  CHANGES_REQUESTED
}

enum TeachingPlanReviewStageType {
  PEER
  QUALITY
  DIITEP
  DIRECTOR
}

enum TeachingPlanWorkflowStatus {
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  CANCELLED
}

enum TeachingPlanWorkflowStageStatus {
  WAITING
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

enum TeachingPlanNotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  email               String                  @unique
  firstName           String                  @default("")
  lastName            String                  @default("")
  nationalId          String?                 @unique
  displayName         String
  passwordHash        String?
  mustChangePassword  Boolean                 @default(false)
  active              Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  roles               UserRole[]
  projects            Project[]               @relation("ProjectOwner")
  weekVersions        WeekVersion[]
  instructions        GenerationInstruction[]
  documents           KnowledgeDocument[]
  retiredInstructions GenerationInstruction[] @relation("GenerationInstructionRetiredBy")
  retiredDocuments    KnowledgeDocument[]      @relation("KnowledgeDocumentRetiredBy")
  auditLogs           AuditLog[]
  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  teachingAssignments TeachingAssignment[]
  indicatorVersions   IndicatorVersion[]
  guideReviews        GuideReview[]
  teachingPlanIndicatorVersions TeachingPlanIndicatorVersion[]
  teachingPlanReviewerAssignments TeachingPlanReviewerAssignment[] @relation("TeachingPlanReviewer")
  teachingPlanReviewerAssignmentsCreated TeachingPlanReviewerAssignment[] @relation("TeachingPlanReviewerAssignedBy")
  careerDirectorAssignments CareerDirectorAssignment[] @relation("CareerDirector")
  careerDirectorAssignmentsCreated CareerDirectorAssignment[] @relation("CareerDirectorAssignedBy")
  teachingPlanWorkflowStages TeachingPlanWorkflowStage[] @relation("TeachingPlanWorkflowReviewer")
  teachingPlanReviews TeachingPlanReview[] @relation("TeachingPlanReviewerUser")
  teachingPlanNotifications TeachingPlanNotification[] @relation("TeachingPlanNotificationRecipient")
  teachingPlanReviewProcessUpdates TeachingPlanReviewProcessConfig[] @relation("TeachingPlanReviewProcessUpdatedBy")
  uploadedLegacyDocuments LegacyAcademicDocument[]
  updatedInstitutionalSettings InstitutionalSetting[]
  thirdLevelDegrees   String[]                @default([])
  fourthLevelDegrees  String[]                @default([])
  teacherFaculty      String?
  teacherDepartment   String?
  teacherDepartmentId String?                  @db.Uuid
  department          TeacherDepartment?       @relation(fields: [teacherDepartmentId], references: [id])
  phone               String?
  shortCv             String?
}


model InstitutionalSetting {
  key         String   @id
  value       String   @db.Text
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model TeacherDepartment {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Project {
  id                              String                  @id @default(uuid()) @db.Uuid
  ownerId                         String                  @db.Uuid
  name                            String
  level                           String
  faculty                         String
  career                          String
  professorName                   String                  @default("")
  subjectCode                     String                  @default("")
  subjectName                     String
  modality                        String
  subjectType                     String                  @default("GENERAL")
  specificationSnapshotIds        String[]                @default([])
  documentSnapshotIds             String[]                @default([])
  indicatorVersionSnapshotId      String?                 @db.Uuid
  academicPeriod                  String
  totalWeeks                      Int
  currentWeek                     Int                     @default(1)
  currentStep                     Int                     @default(1)
  workflowMode                    ProjectWorkflowMode?
  adaptationPlanApprovedAt        DateTime?
  adaptationGuideApprovedAt       DateTime?
  guideReference                  String                  @default("")
  microcurricularPresentation     String                  @default("")
  guideReferenceImportance        String                  @default("")
  basicBib                        String
  complementaryBib                String
  reaBib                          String?
  professionalProfileCompetencies String[]                @default([])
  graduateProfileResults          String[]                @default([])
  utplGenericCompetencies         String[]                @default([])
  status                          ProjectStatus           @default(DRAFT)
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  owner                           User                    @relation("ProjectOwner", fields: [ownerId], references: [id])
  matrix                          Matrix?
  weeks                           ProjectWeek[]
  attachments                     Attachment[]
  academicOfferingId              String                  @unique @db.Uuid
  teachingAssignmentId            String?                 @db.Uuid
  sourceProjectId                 String?                 @db.Uuid
  academicOffering                AcademicOffering        @relation(fields: [academicOfferingId], references: [id])
  teachingAssignment              TeachingAssignment?     @relation(fields: [teachingAssignmentId], references: [id])
  sourceProject                   Project?                @relation("ProjectLineage", fields: [sourceProjectId], references: [id])
  derivedProjects                 Project[]               @relation("ProjectLineage")
  guideReviews                    GuideReview[]
  generatedImages                 GeneratedImage[]
  canonicalGuide                  CanonicalGuideDocument?
  institutionalDataReviewedAt     DateTime?
  outcomeMappings                 Json?
  teacherProfileSnapshot          Json?
  teachingPlan                    TeachingPlan?
  bibliographyEntries             ProjectBibliographyEntry[]
  legacyDocuments                 LegacyAcademicDocument[]
  adaptationProposals             AdaptationProposal[]
  teachingPlanReviewerAssignments TeachingPlanReviewerAssignment[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, subjectCode])
}


model LegacyAcademicDocument {
  id             String             @id @default(uuid()) @db.Uuid
  projectId      String             @db.Uuid
  type           LegacyDocumentType
  originalName   String
  storagePath    String
  mimeType       String
  sizeBytes      Int
  checksum       String
  academicPeriod String?
  versionLabel   String?
  active         Boolean            @default(true)
  uploadedById   String?            @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy     User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  proposals      AdaptationProposal[]

  @@index([projectId, type, active])
  @@index([uploadedById, createdAt])
}

model AdaptationProposal {
  id                  String                     @id @default(uuid()) @db.Uuid
  projectId           String                     @db.Uuid
  sourceDocumentId    String                     @db.Uuid
  target              AdaptationTarget
  status              AdaptationProposalStatus   @default(DRAFT)
  sourceWeeks         Int                        @default(16)
  targetWeeks         Int                        @default(8)
  title               String
  overview            String
  weeklyStructure     Json
  templateSnapshotId  String?                    @db.Uuid
  promptSnapshotId    String?                    @db.Uuid
  documentSnapshotIds String[]                   @default([])
  specificationSnapshotIds String[]              @default([])
  generatedAt         DateTime                   @default(now())
  approvedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument      LegacyAcademicDocument     @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  changes             AdaptationChange[]

  @@index([projectId, target, status])
  @@index([sourceDocumentId, generatedAt])
}

model AdaptationChange {
  id                    String               @id @default(uuid()) @db.Uuid
  proposalId            String               @db.Uuid
  sortOrder             Int
  action                AdaptationAction
  sourceWeeks           Int[]                @default([])
  sourceContent         String
  sourceWeekBreakdown   Json?
  proposedWeeks         Int[]                @default([])
  proposedContent       String
  proposedWeekBreakdown Json?
  rationale             String
  learningOutcomes      String[]             @default([])
  hoursImpact           String
  evaluationImpact      String
  institutionalSources  String[]             @default([])
  decision              AdaptationDecision   @default(PENDING)
  teacherEditedContent  String?
  teacherComment        String?
  decidedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  proposal              AdaptationProposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, sortOrder])
  @@index([proposalId, decision])
}

model ProjectBibliographyEntry {
  id        String                @id @default(uuid()) @db.Uuid
  projectId String                @db.Uuid
  type      BibliographyEntryType
  citation  String                @default("")
  title     String                @default("")
  url       String                @default("")
  notes     String                @default("")
  sortOrder Int                   @default(100)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, type, sortOrder])
}

model AcademicLevel {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String            @unique
  active    Boolean           @default(true)
  sortOrder Int               @default(100)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  programs  AcademicProgram[]
}

model Modality {
  id        String             @id @default(uuid()) @db.Uuid
  code      String             @unique
  name      String             @unique
  active    Boolean            @default(true)
  sortOrder Int                @default(100)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  offerings AcademicOffering[]
}

model AcademicUnit {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String            @unique
  active    Boolean           @default(true)
  sortOrder Int               @default(100)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  programs  AcademicProgram[]
}

model AcademicProgram {
  id              String             @id @default(uuid()) @db.Uuid
  code            String             @unique
  name            String
  academicLevelId String             @db.Uuid
  academicUnitId  String             @db.Uuid
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  academicLevel   AcademicLevel      @relation(fields: [academicLevelId], references: [id])
  academicUnit    AcademicUnit       @relation(fields: [academicUnitId], references: [id])
  offerings       AcademicOffering[]
  directorAssignments CareerDirectorAssignment[]

  @@unique([name, academicLevelId, academicUnitId])
  @@index([academicLevelId, academicUnitId])
}

model SubjectType {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique
  name         String             @unique
  active       Boolean            @default(true)
  sortOrder    Int                @default(100)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  offerings    AcademicOffering[]
  planCategory String?
}

model AcademicPeriod {
  id        String             @id @default(uuid()) @db.Uuid
  code      String             @unique
  name      String             @unique
  startsAt                     DateTime?
  endsAt                       DateTime?
  bimestralEvaluationAt        DateTime? // Compatibilidad histórica: inicio del intervalo bimestral
  bimestralEvaluationStartAt   DateTime?
  bimestralEvaluationEndAt     DateTime?
  recoveryEvaluationStartAt    DateTime?
  recoveryEvaluationEndAt      DateTime?
  active                       Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  offerings AcademicOffering[]
}

model Course {
  id        String             @id @default(uuid()) @db.Uuid
  code      String             @unique
  name      String
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  offerings AcademicOffering[]
}

model AcademicOffering {
  id                              String               @id @default(uuid()) @db.Uuid
  code                            String               @unique
  courseId                        String               @db.Uuid
  programId                       String               @db.Uuid
  modalityId                      String               @db.Uuid
  subjectTypeId                   String               @db.Uuid
  periodId                        String               @db.Uuid
  totalWeeks                      Int                  @default(8)
  credits                         Decimal?             @db.Decimal(6, 2)
  acdHours                        Int                  @default(0)
  apeHours                        Int                  @default(0)
  aaHours                         Int                  @default(0)
  semester                        String?
  description                     String?
  prerequisites                   String[]             @default([])
  learningOutcomes                String[]             @default([])
  professionalProfileCompetencies String[]             @default([])
  graduateProfileResults          String[]             @default([])
  utplGenericCompetencies         String[]             @default([])
  unitContents                    String[]             @default([])
  active                          Boolean              @default(true)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt
  course                          Course               @relation(fields: [courseId], references: [id])
  program                         AcademicProgram      @relation(fields: [programId], references: [id])
  modality                        Modality             @relation(fields: [modalityId], references: [id])
  subjectType                     SubjectType          @relation(fields: [subjectTypeId], references: [id])
  period                          AcademicPeriod       @relation(fields: [periodId], references: [id])
  assignments                     TeachingAssignment[]
  projects                        Project[]
  learningOutcomeItems            AcademicOfferingLearningOutcome[]
  professionalCompetencyItems     AcademicOfferingProfessionalCompetency[]
  graduateProfileResultItems      AcademicOfferingGraduateProfileResult[]
  genericCompetencyLinks          AcademicOfferingGenericCompetency[]
  units                           AcademicOfferingUnit[]

  @@unique([courseId, programId, modalityId, subjectTypeId, periodId])
  @@index([programId, periodId, active])
  @@index([courseId, periodId])
}


model UtplGenericCompetency {
  id            String                              @id @default(uuid()) @db.Uuid
  code          String                              @unique
  name          String                              @unique
  active        Boolean                             @default(true)
  sortOrder     Int                                 @default(100)
  createdAt     DateTime                            @default(now())
  updatedAt     DateTime                            @updatedAt
  offeringLinks AcademicOfferingGenericCompetency[]
}

model AcademicOfferingLearningOutcome {
  id                 String           @id @default(uuid()) @db.Uuid
  academicOfferingId String           @db.Uuid
  text               String
  sortOrder          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)

  @@unique([academicOfferingId, sortOrder])
  @@index([academicOfferingId])
}

model AcademicOfferingProfessionalCompetency {
  id                 String           @id @default(uuid()) @db.Uuid
  academicOfferingId String           @db.Uuid
  text               String
  sortOrder          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)

  @@unique([academicOfferingId, sortOrder])
  @@index([academicOfferingId])
}

model AcademicOfferingGraduateProfileResult {
  id                 String           @id @default(uuid()) @db.Uuid
  academicOfferingId String           @db.Uuid
  text               String
  sortOrder          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)

  @@unique([academicOfferingId, sortOrder])
  @@index([academicOfferingId])
}

model AcademicOfferingGenericCompetency {
  academicOfferingId String                @db.Uuid
  competencyId       String                @db.Uuid
  sortOrder          Int
  createdAt          DateTime              @default(now())
  academicOffering   AcademicOffering      @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)
  competency         UtplGenericCompetency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([academicOfferingId, competencyId])
  @@unique([academicOfferingId, sortOrder])
  @@index([competencyId])
}

model AcademicOfferingUnit {
  id                 String                        @id @default(uuid()) @db.Uuid
  academicOfferingId String                        @db.Uuid
  title              String
  sortOrder          Int
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  academicOffering   AcademicOffering              @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)
  contents           AcademicOfferingUnitContent[]

  @@unique([academicOfferingId, sortOrder])
  @@index([academicOfferingId])
}

model AcademicOfferingUnitContent {
  id        String               @id @default(uuid()) @db.Uuid
  unitId    String               @db.Uuid
  text      String
  sortOrder Int
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  unit        AcademicOfferingUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subcontents AcademicOfferingUnitSubcontent[]

  @@unique([unitId, sortOrder])
  @@index([unitId])
}

model AcademicOfferingUnitSubcontent {
  id        String                      @id @default(uuid()) @db.Uuid
  contentId String                      @db.Uuid
  text      String
  sortOrder Int
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
  content   AcademicOfferingUnitContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, sortOrder])
  @@index([contentId])
}

model TeachingAssignment {
  id                 String           @id @default(uuid()) @db.Uuid
  teacherId          String           @db.Uuid
  academicOfferingId String           @db.Uuid
  active             Boolean          @default(true)
  assignedAt         DateTime         @default(now())
  endedAt            DateTime?
  teacher            User             @relation(fields: [teacherId], references: [id])
  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id])
  projects           Project[]

  @@index([teacherId, active])
  @@index([academicOfferingId, assignedAt])
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt, usedAt])
}

model Matrix {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @unique @db.Uuid
  originalName String?
  checksum     String?
  createdAt    DateTime    @default(now())
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rows         MatrixRow[]
}

model MatrixRow {
  id              String @id @default(uuid()) @db.Uuid
  matrixId        String @db.Uuid
  rowOrder        Int
  weekNumber      Int
  learningOutcome String
  unitContent     String
  methodology     String
  matrix          Matrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@unique([matrixId, rowOrder])
  @@index([matrixId, weekNumber])
}

model ProjectWeek {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @db.Uuid
  weekNumber      Int
  status          WeekStatus       @default(PENDING)
  draftContent    String?
  approvedContent String?
  approvedAt      DateTime?
  currentVersion  Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        WeekVersion[]
  attachments     Attachment[]
  generatedImages GeneratedImage[]

  @@unique([projectId, weekNumber])
  @@index([projectId, status])
}

model GeneratedImage {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String?      @db.Uuid
  projectWeekId String?      @db.Uuid
  weekNumber    Int
  figureNumber  Int
  title         String
  altText       String
  source        String       @default("Elaboración propia mediante IA")
  prompt        String
  style         String
  mimeType      String       @default("image/png")
  imageData     Bytes
  createdAt     DateTime     @default(now())
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectWeek   ProjectWeek? @relation(fields: [projectWeekId], references: [id], onDelete: Cascade)

  @@index([projectId, weekNumber])
  @@index([projectWeekId])
}

model CanonicalGuideDocument {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @unique @db.Uuid
  schemaVersion String
  document      Json
  checksum      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([schemaVersion])
}

model WeekVersion {
  id                     String      @id @default(uuid()) @db.Uuid
  projectWeekId          String      @db.Uuid
  versionNumber          Int
  status                 WeekStatus
  content                String
  adjustmentInstructions String?
  createdById            String?     @db.Uuid
  createdAt              DateTime    @default(now())
  projectWeek            ProjectWeek @relation(fields: [projectWeekId], references: [id], onDelete: Cascade)
  createdBy              User?       @relation(fields: [createdById], references: [id])

  @@unique([projectWeekId, versionNumber])
}

model GenerationInstruction {
  id               String         @id @default(uuid()) @db.Uuid
  key              String
  title            String
  content          String
  version          Int
  status           DocumentStatus @default(DRAFT)
  academicLevels   String[]       @default([])
  modalities       String[]       @default([])
  durations        Int[]          @default([])
  subjectTypes     String[]       @default([])
  processes        String[]       @default(["GUIDE_GENERATION", "GUIDE_ADAPTATION"])
  priority         Int            @default(100)
  impactAnalysis   Json?
  impactChecksum   String?
  createdById      String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  activatedAt      DateTime?
  retiredAt        DateTime?
  retirementReason String?
  retiredById      String?        @db.Uuid
  createdBy        User?          @relation(fields: [createdById], references: [id])
  retiredBy        User?          @relation("GenerationInstructionRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)

  @@unique([key, version])
  @@index([retiredById])
  @@index([key, status])
}

model KnowledgeDocument {
  id               String         @id @default(uuid()) @db.Uuid
  key              String
  title            String
  version          Int
  status           DocumentStatus @default(DRAFT)
  storagePath      String
  mimeType         String
  originalName     String?
  contentMarkdown  String?
  priority         Int            @default(100)
  academicLevels   String[]       @default([])
  modalities       String[]       @default([])
  durations        Int[]          @default([])
  subjectTypes     String[]       @default([])
  appliesToAll     Boolean        @default(true)
  impactAnalysis   Json?
  impactChecksum   String?
  checksum         String?
  createdById      String?        @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  activatedAt      DateTime?
  retiredAt        DateTime?
  retirementReason String?
  retiredById      String?        @db.Uuid
  createdBy        User?          @relation(fields: [createdById], references: [id])
  retiredBy        User?          @relation("KnowledgeDocumentRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  resourceKind     String         @default("INSTITUTIONAL_DOCUMENT")
  appliesToPlan    Boolean        @default(false)
  appliesToGuide   Boolean        @default(true)
  effectiveFrom    DateTime?
  provisional      Boolean        @default(false)

  @@unique([key, version])
  @@index([key, status])
  @@index([status, priority])
  @@index([retiredById])
}

model TeachingPlan {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @unique @db.Uuid
  schemaVersion       String   @default("1.0.0")
  status              String   @default("DRAFT")
  content             Json
  version             Int      @default(1)
  templateSnapshotId  String?  @db.Uuid
  promptSnapshotId    String?  @db.Uuid
  documentSnapshotIds String[] @default([])
  specificationSnapshotIds String[] @default([])
  teacherReviewedAt   DateTime?
  teacherReviewNotes  String?
  generatedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities          TeachingPlanActivity[]
  reviewWorkflow      TeachingPlanReviewWorkflow?

  @@index([status, updatedAt])
}

model TeachingPlanReviewProcessConfig {
  id          String   @id @default("DEFAULT")
  enabled     Boolean  @default(false)
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("TeachingPlanReviewProcessUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stages      TeachingPlanReviewStageConfig[]
}

model TeachingPlanReviewStageConfig {
  id              String                      @id @default(uuid()) @db.Uuid
  processConfigId String
  stage           TeachingPlanReviewStageType
  enabled         Boolean                     @default(true)
  sortOrder       Int
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  processConfig   TeachingPlanReviewProcessConfig @relation(fields: [processConfigId], references: [id], onDelete: Cascade)

  @@unique([processConfigId, stage])
  @@index([processConfigId, enabled, sortOrder])
}

model TeachingPlanReviewerAssignment {
  id           String                      @id @default(uuid()) @db.Uuid
  projectId    String                      @db.Uuid
  stage        TeachingPlanReviewStageType
  reviewerId   String                      @db.Uuid
  assignedById String?                     @db.Uuid
  active       Boolean                     @default(true)
  assignedAt   DateTime                    @default(now())
  endedAt      DateTime?
  project      Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer     User                        @relation("TeachingPlanReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  assignedBy   User?                       @relation("TeachingPlanReviewerAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([projectId, stage, active])
  @@index([reviewerId, active])
}

model CareerDirectorAssignment {
  id           String          @id @default(uuid()) @db.Uuid
  programId    String          @db.Uuid
  directorId   String          @db.Uuid
  assignedById String?         @db.Uuid
  active       Boolean         @default(true)
  assignedAt   DateTime        @default(now())
  endedAt      DateTime?
  program      AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  director     User            @relation("CareerDirector", fields: [directorId], references: [id], onDelete: Restrict)
  assignedBy   User?           @relation("CareerDirectorAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([programId, active])
  @@index([directorId, active])
}

model TeachingPlanIndicatorVersion {
  id          String                  @id @default(uuid()) @db.Uuid
  version     Int                     @unique
  title       String
  status      DocumentStatus          @default(DRAFT)
  createdById String?                 @db.Uuid
  createdAt   DateTime                @default(now())
  activatedAt DateTime?
  createdBy   User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  indicators  TeachingPlanIndicator[]
  workflows   TeachingPlanReviewWorkflow[]
  reviews     TeachingPlanReview[]
}

model TeachingPlanIndicator {
  id          String                      @id @default(uuid()) @db.Uuid
  versionId   String                      @db.Uuid
  code        String
  name        String                      @default("")
  description String
  stage       TeachingPlanReviewStageType
  active      Boolean                     @default(true)
  required    Boolean                     @default(true)
  sortOrder   Int
  version     TeachingPlanIndicatorVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewItems TeachingPlanReviewItem[]

  @@unique([versionId, code])
  @@index([versionId, stage, sortOrder])
}

model TeachingPlanReviewWorkflow {
  id                 String                     @id @default(uuid()) @db.Uuid
  teachingPlanId     String                     @unique @db.Uuid
  indicatorVersionId String                     @db.Uuid
  status             TeachingPlanWorkflowStatus @default(IN_REVIEW)
  startedAt          DateTime                   @default(now())
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  teachingPlan       TeachingPlan               @relation(fields: [teachingPlanId], references: [id], onDelete: Cascade)
  indicatorVersion   TeachingPlanIndicatorVersion @relation(fields: [indicatorVersionId], references: [id], onDelete: Restrict)
  stages             TeachingPlanWorkflowStage[]
  notifications      TeachingPlanNotification[]

  @@index([status, updatedAt])
}

model TeachingPlanWorkflowStage {
  id          String                           @id @default(uuid()) @db.Uuid
  workflowId  String                           @db.Uuid
  stage       TeachingPlanReviewStageType
  sortOrder   Int
  reviewerId  String?                          @db.Uuid
  status      TeachingPlanWorkflowStageStatus  @default(WAITING)
  approvedAt  DateTime?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  workflow    TeachingPlanReviewWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reviewer    User?                            @relation("TeachingPlanWorkflowReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviews     TeachingPlanReview[]

  @@unique([workflowId, stage])
  @@index([reviewerId, status])
  @@index([workflowId, sortOrder])
}

model TeachingPlanReview {
  id                 String                    @id @default(uuid()) @db.Uuid
  workflowStageId    String                    @db.Uuid
  indicatorVersionId String                    @db.Uuid
  attempt            Int
  teachingPlanVersion Int
  decision           ReviewDecision            @default(DRAFT)
  generalObservation String?
  reviewedById       String?                   @db.Uuid
  reviewedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  workflowStage      TeachingPlanWorkflowStage @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  indicatorVersion   TeachingPlanIndicatorVersion @relation(fields: [indicatorVersionId], references: [id], onDelete: Restrict)
  reviewedBy         User?                     @relation("TeachingPlanReviewerUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  items              TeachingPlanReviewItem[]
  notifications      TeachingPlanNotification[]

  @@unique([workflowStageId, attempt])
  @@index([decision, reviewedAt])
}

model TeachingPlanReviewItem {
  id          String                @id @default(uuid()) @db.Uuid
  reviewId    String                @db.Uuid
  indicatorId String                @db.Uuid
  result      ChecklistResult       @default(PENDING)
  observation String?
  review      TeachingPlanReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  indicator   TeachingPlanIndicator @relation(fields: [indicatorId], references: [id], onDelete: Restrict)

  @@unique([reviewId, indicatorId])
}

model TeachingPlanNotification {
  id              String                         @id @default(uuid()) @db.Uuid
  workflowId      String                         @db.Uuid
  reviewId        String?                        @db.Uuid
  event           String
  stage           TeachingPlanReviewStageType?
  recipientUserId String?                        @db.Uuid
  recipientEmail  String
  recipientName   String                         @default("")
  subject         String
  body            String                         @db.Text
  status          TeachingPlanNotificationStatus @default(PENDING)
  attemptCount    Int                            @default(0)
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  errorMessage    String?                        @db.Text
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  workflow        TeachingPlanReviewWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  review          TeachingPlanReview?            @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  recipient       User?                          @relation("TeachingPlanNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([workflowId, createdAt])
  @@index([recipientUserId, status])
  @@index([status, createdAt])
}

model TeachingPlanActivity {
  id              String                    @id @default(uuid()) @db.Uuid
  teachingPlanId  String                    @db.Uuid
  sequenceOrder   Int
  learningOutcome String
  weekNumber      Int
  sortOrder       Int
  component       TeachingActivityComponent
  description     String
  unitContents    String[]                  @default([])
  resources       String[]                  @default([])
  resource        String?
  hours           Int                       @default(0)
  weekAcdHours    Int                       @default(0)
  weekApeHours    Int                       @default(0)
  weekAaHours     Int                       @default(0)
  evaluatedCode   String?
  actualGrade     Float?
  weight          Int?
  workStrategies  String?
  workStrategyItems String[]                 @default([])
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  teachingPlan    TeachingPlan              @relation(fields: [teachingPlanId], references: [id], onDelete: Cascade)
  instrument      TeachingPlanInstrument?

  @@unique([teachingPlanId, sequenceOrder, weekNumber, sortOrder])
  @@index([teachingPlanId, weekNumber])
  @@index([teachingPlanId, evaluatedCode])
}

model TeachingPlanInstrument {
  id                           String                       @id @default(uuid()) @db.Uuid
  activityId                   String                       @unique @db.Uuid
  type                         TeachingPlanInstrumentType
  title                        String
  maximumScore                 Float                        @default(10)
  questionnaireGradingMode     QuestionnaireGradingMode?
  questionnaireQuestionCount   Int?
  questionnaireTimeMinutes     Int?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  activity                     TeachingPlanActivity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  criteria                     TeachingPlanInstrumentCriterion[]

  @@index([type])
}

model TeachingPlanInstrumentCriterion {
  id           String                         @id @default(uuid()) @db.Uuid
  instrumentId String                         @db.Uuid
  sortOrder    Int
  label        String
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  instrument   TeachingPlanInstrument         @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  levels       TeachingPlanInstrumentLevel[]

  @@unique([instrumentId, sortOrder])
  @@index([instrumentId])
}

model TeachingPlanInstrumentLevel {
  id          String                          @id @default(uuid()) @db.Uuid
  criterionId String                          @db.Uuid
  sortOrder   Int
  label       String
  description String                          @default("")
  score       Float
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  criterion   TeachingPlanInstrumentCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, sortOrder])
  @@index([criterionId])
}

model IndicatorVersion {
  id          String           @id @default(uuid()) @db.Uuid
  version     Int              @unique
  title       String
  status      DocumentStatus   @default(DRAFT)
  createdById String?          @db.Uuid
  createdAt   DateTime         @default(now())
  activatedAt DateTime?
  createdBy   User?            @relation(fields: [createdById], references: [id])
  indicators  GuideIndicator[]
  reviews     GuideReview[]
}

model GuideIndicator {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  code        String
  name        String            @default("")
  description String
  stage       ReviewStage       @default(PEER)
  score       Decimal           @default(0) @db.Decimal(8, 4)
  active      Boolean           @default(true)
  required    Boolean           @default(true)
  sortOrder   Int
  version     IndicatorVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewItems GuideReviewItem[]

  @@unique([versionId, code])
  @@index([versionId, sortOrder])
}

model GuideReview {
  id                 String            @id @default(uuid()) @db.Uuid
  projectId          String            @db.Uuid
  indicatorVersionId String            @db.Uuid
  stage              ReviewStage
  decision           ReviewDecision    @default(DRAFT)
  generalObservation String?
  earnedScore        Decimal?          @db.Decimal(8, 4)
  possibleScore      Decimal?          @db.Decimal(8, 4)
  percentage         Decimal?          @db.Decimal(6, 2)
  category           String?
  reviewedById       String?           @db.Uuid
  reviewedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  indicatorVersion   IndicatorVersion  @relation(fields: [indicatorVersionId], references: [id])
  reviewedBy         User?             @relation(fields: [reviewedById], references: [id])
  items              GuideReviewItem[]

  @@unique([projectId, stage])
  @@index([stage, decision])
}

model GuideReviewItem {
  id          String          @id @default(uuid()) @db.Uuid
  reviewId    String          @db.Uuid
  indicatorId String          @db.Uuid
  result      ChecklistResult @default(PENDING)
  observation String?
  review      GuideReview     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  indicator   GuideIndicator  @relation(fields: [indicatorId], references: [id])

  @@unique([reviewId, indicatorId])
}

