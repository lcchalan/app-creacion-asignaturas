generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum WeekStatus {
  PENDING
  GENERATED
  IN_REVIEW
  APPROVED
  REQUIRES_REVIEW
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AttachmentKind {
  MATRIX
  BIBLIOGRAPHY
  WEEK_ADJUSTMENT
  GENERATED_IMAGE
  KNOWLEDGE
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  displayName  String
  passwordHash String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  roles        UserRole[]
  projects     Project[]   @relation("ProjectOwner")
  weekVersions WeekVersion[]
  instructions GenerationInstruction[]
  documents    KnowledgeDocument[]
  auditLogs    AuditLog[]
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  users       UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  ownerId        String        @db.Uuid
  name           String
  level          String
  faculty        String
  career         String
  professorName  String        @default("")
  subjectCode    String        @default("")
  subjectName    String
  modality       String
  academicPeriod String
  totalWeeks     Int
  currentWeek    Int           @default(1)
  basicBib       String
  complementaryBib String
  reaBib         String?
  status         ProjectStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  owner          User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  matrix         Matrix?
  weeks          ProjectWeek[]
  attachments    Attachment[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, subjectCode])
}

model Matrix {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @unique @db.Uuid
  originalName String?
  checksum     String?
  createdAt    DateTime    @default(now())
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rows         MatrixRow[]
}

model MatrixRow {
  id              String @id @default(uuid()) @db.Uuid
  matrixId        String @db.Uuid
  rowOrder        Int
  weekNumber      Int
  learningOutcome String
  unitContent     String
  methodology     String
  matrix          Matrix @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@unique([matrixId, rowOrder])
  @@index([matrixId, weekNumber])
}

model ProjectWeek {
  id              String      @id @default(uuid()) @db.Uuid
  projectId       String      @db.Uuid
  weekNumber      Int
  status          WeekStatus  @default(PENDING)
  draftContent    String?
  approvedContent String?
  approvedAt      DateTime?
  currentVersion  Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions        WeekVersion[]
  attachments     Attachment[]

  @@unique([projectId, weekNumber])
  @@index([projectId, status])
}

model WeekVersion {
  id                    String      @id @default(uuid()) @db.Uuid
  projectWeekId         String      @db.Uuid
  versionNumber         Int
  status                WeekStatus
  content               String
  adjustmentInstructions String?
  createdById           String?     @db.Uuid
  createdAt             DateTime    @default(now())
  projectWeek           ProjectWeek @relation(fields: [projectWeekId], references: [id], onDelete: Cascade)
  createdBy             User?       @relation(fields: [createdById], references: [id])

  @@unique([projectWeekId, versionNumber])
}

model GenerationInstruction {
  id          String         @id @default(uuid()) @db.Uuid
  key         String
  title       String
  content     String
  version     Int
  status      DocumentStatus @default(DRAFT)
  createdById String?        @db.Uuid
  createdAt   DateTime       @default(now())
  activatedAt DateTime?
  createdBy   User?          @relation(fields: [createdById], references: [id])

  @@unique([key, version])
  @@index([key, status])
}

model KnowledgeDocument {
  id           String         @id @default(uuid()) @db.Uuid
  key          String
  title        String
  version      Int
  status       DocumentStatus @default(DRAFT)
  storagePath  String
  mimeType     String
  checksum     String?
  createdById  String?        @db.Uuid
  createdAt    DateTime       @default(now())
  activatedAt  DateTime?
  createdBy    User?          @relation(fields: [createdById], references: [id])

  @@unique([key, version])
  @@index([key, status])
}

model Attachment {
  id            String         @id @default(uuid()) @db.Uuid
  projectId     String?        @db.Uuid
  projectWeekId String?        @db.Uuid
  kind          AttachmentKind
  originalName  String
  storagePath   String
  mimeType      String
  sizeBytes     Int
  checksum      String?
  contentBase64 String?
  createdAt     DateTime       @default(now())
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectWeek   ProjectWeek?   @relation(fields: [projectWeekId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
