{
  "name": "app-creacion-asignaturas",
  "version": "1.0.0",
  "description": "Aplicación para la creación y revisión de asignaturas mediante Apps SDK y MCP",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:backfill-canonical": "node --import tsx prisma/backfill-canonical-guides.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcchalan/app-creacion-asignaturas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/lcchalan/app-creacion-asignaturas/issues"
  },
  "homepage": "https://github.com/lcchalan/app-creacion-asignaturas#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.19.3",
    "docx": "^9.5.1",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "openai": "^6.49.0",
    "read-excel-file": "^9.3.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
