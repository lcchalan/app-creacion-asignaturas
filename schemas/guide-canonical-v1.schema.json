{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/guide-canonical-v1.schema.json",
  "title": "Guía didáctica canónica v1",
  "description": "Contrato interoperable para una guía didáctica. Los contenidos se conservan en Markdown y los activos se referencian sin incluir datos base64.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "documentType",
    "documentId",
    "language",
    "status",
    "metadata",
    "planning",
    "bibliography",
    "weeks",
    "assets",
    "traceability"
  ],
  "properties": {
    "$schema": { "const": "/schemas/guide-canonical-v1.schema.json" },
    "schemaVersion": { "const": "1.0.0" },
    "documentType": { "const": "didactic-guide" },
    "documentId": { "type": "string", "format": "uuid" },
    "language": { "const": "es" },
    "status": {
      "enum": ["draft", "in_progress", "completed", "archived"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectName",
        "academicLevel",
        "faculty",
        "career",
        "professorName",
        "subject",
        "modality",
        "academicPeriod",
        "totalWeeks"
      ],
      "properties": {
        "projectName": { "type": "string", "minLength": 1 },
        "academicLevel": { "type": "string", "minLength": 1 },
        "faculty": { "type": "string", "minLength": 1 },
        "career": { "type": "string", "minLength": 1 },
        "professorName": { "type": "string" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "name", "type"],
          "properties": {
            "code": { "type": "string" },
            "name": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "minLength": 1 }
          }
        },
        "modality": { "type": "string", "minLength": 1 },
        "academicPeriod": { "type": "string", "minLength": 1 },
        "totalWeeks": { "type": "integer", "minimum": 1 }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMatrix"],
      "properties": {
        "sourceMatrix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "rows"],
          "properties": {
            "fileName": { "type": ["string", "null"] },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/matrixRow" }
            }
          }
        }
      }
    },
    "bibliography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "basic", "complementary", "openEducationalResources"],
      "properties": {
        "format": { "const": "markdown" },
        "basic": { "type": "string" },
        "complementary": { "type": "string" },
        "openEducationalResources": { "type": "string" }
      }
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/week" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/imageAsset" }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSystem", "createdAt", "updatedAt"],
      "properties": {
        "sourceSystem": { "const": "app-creacion-asignaturas" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "matrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "weekNumber",
        "learningOutcome",
        "unitContentLiteral",
        "methodology"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "weekNumber": { "type": "integer", "minimum": 1 },
        "learningOutcome": { "type": "string", "minLength": 1 },
        "unitContentLiteral": { "type": "string", "minLength": 1 },
        "methodology": { "type": "string", "minLength": 1 }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekNumber",
        "status",
        "sourceMatrixRowIds",
        "content",
        "currentVersion",
        "approvedAt"
      ],
      "properties": {
        "weekNumber": { "type": "integer", "minimum": 1 },
        "status": {
          "enum": ["pending", "generated", "in_review", "approved", "requires_review"]
        },
        "sourceMatrixRowIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "draft", "approved"],
          "properties": {
            "format": { "const": "markdown" },
            "draft": { "type": "string" },
            "approved": { "type": ["string", "null"] }
          }
        },
        "currentVersion": { "type": "integer", "minimum": 0 },
        "approvedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "imageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "weekNumber",
        "figureNumber",
        "title",
        "altText",
        "source",
        "prompt",
        "style",
        "mimeType",
        "fileName",
        "storage"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "kind": { "const": "image" },
        "weekNumber": { "type": "integer", "minimum": 1 },
        "figureNumber": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "altText": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "mimeType": { "type": "string", "pattern": "^image/" },
        "fileName": { "type": "string", "minLength": 1 },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "href"],
          "properties": {
            "type": { "const": "endpoint" },
            "href": { "type": "string", "pattern": "^/api/generated-images/" }
          }
        }
      }
    }
  }
}
