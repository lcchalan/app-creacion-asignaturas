# Copie este archivo como .env solo para desarrollo local.
# En producción, configure estos valores en el gestor de secretos del servidor.
# Nunca confirme .env ni claves reales en Git.

# Aplicación
NODE_ENV=development
PORT=3000
MCP_SERVER_NAME=app-creacion-asignaturas
MCP_SERVER_VERSION=1.0.0

# PostgreSQL
# Esta URL coincide con docker-compose.yml. Si usa una base remota, reemplácela.
# Los caracteres especiales del usuario o contraseña deben codificarse para una URL.
DATABASE_URL="postgresql://guias_app:guias_local@localhost:5432/guias_didacticas?schema=public"

# OpenAI
# La clave debe pertenecer al proyecto de OpenAI destinado a este entorno.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Valor histórico de la versión 28; confirme que el modelo siga habilitado en su proyecto.
OPENAI_IMAGE_MODEL=gpt-image-1

# Inicialización de una base limpia (solo los usa prisma/seed.ts)
# Sustituya ambos valores antes de ejecutar el seed por primera vez.
LOCAL_USER_EMAIL=administrador@institucion.edu
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_LARGA_Y_UNICA
